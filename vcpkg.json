{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "risen-spass",
  "version-string": "0.1.0",
  "description": "Hook-based Lua (LuaJIT) scripting layer for Risen (Enhanced, x64)",
  "builtin-baseline": "39344dff01c5a5a0134caf2624cdd492f05d30ea",
  "dependencies": [
    "luajit",
    {
      "name": "minhook",
      "platform": "windows"
    },
    "sol2",
    "spdlog",
    "tomlplusplus",
    "zlib"
  ],
  "features": {
    "modkit": {
      "description": "risen-modkit, the cross-platform mod editor (docs/editor/REQUIREMENTS.md)",
      "dependencies": [
        "glfw3",
        "glm",
        {
          "name": "glad",
          "features": [
            "gl-api-33"
          ]
        },
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "glfw-binding",
            "opengl3-binding"
          ]
        },
        "imgui-node-editor",
        "imguizmo",
        "miniaudio",
        "nativefiledialog-extended",
        "nlohmann-json",
        "stb"
      ]
    }
  }
}
